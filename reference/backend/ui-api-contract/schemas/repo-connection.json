{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoConnection",
  "type": "object",
  "required": [
    "id",
    "provider"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "ownerOrOrg": {
      "type": "string"
    },
    "repoName": {
      "type": "string"
    },
    "defaultBranch": {
      "type": "string"
    }
  }
}
